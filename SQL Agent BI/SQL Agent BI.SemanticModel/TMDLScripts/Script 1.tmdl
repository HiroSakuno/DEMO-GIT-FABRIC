
    table 'Medidas' {

      measures = {

        measure 'Total Orders' {
          expression = "COUNTROWS('Fact | Orders')"
          formatString = "#,0"
        }

        measure 'Total Quantity' {
          expression = "SUM('Fact | Orders'[quantity])"
          formatString = "#,0"
        }

        measure 'Total Revenue' {
          expression = "SUM('Fact | Orders'[totalamount])"
          formatString = "$#,0.00"
        }

        measure 'Average Ticket' {
          expression = "DIVIDE([Total Revenue], [Total Orders])"
          formatString = "$#,0.00"
        }

        measure 'Unique Customers' {
          expression = "DISTINCTCOUNT('Fact | Orders'[customerid])"
          formatString = "#,0"
        }

        measure '% Cancelled Orders' {
          expression = "
            DIVIDE(
              CALCULATE([Total Orders], 'Dim | Order Status'[statusname] = \"Cancelled\"),
              [Total Orders]
            )
          "
          formatString = "0.00%"
        }

        measure 'Current Stock' {
          expression = "SUM('Fact | Inventory Snapshot'[quantity])"
          formatString = "#,0"
        }

        measure 'Stock Coverage (Days)' {
          expression = "
            DIVIDE(
              [Current Stock],
              DIVIDE([Total Quantity], DISTINCTCOUNT('Dim | Calendar'[calendardate]))
            )
          "
          formatString = "#,0"
        }
      }
    }